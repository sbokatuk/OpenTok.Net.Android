<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs against the packed .nupkg files in artifacts/, not against the binding projects, so it
    catches packaging regressions the compiler cannot see — most importantly the
    net8.0-android34.0 "empty shell" trap described in src/OpenTok.Binding.props, which builds with
    0 errors and 0 warnings and produces a binding assembly with no real content.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
