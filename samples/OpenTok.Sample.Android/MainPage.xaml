<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:OpenTok.Sample.Android"
             x:Class="OpenTok.Sample.Android.MainPage"
             Title="OpenTok.Net.Android">

    <!-- Deliberately the same layout as samples/OpenTok.Sample.iOS/MainPage.xaml, so the two
         samples read side by side and the only differences are the ones the SDKs actually force. -->
    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="16" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Entry x:Name="ApiKeyEntry" Placeholder="OpenTok API key" Keyboard="Numeric" />
            <Entry x:Name="SessionIdEntry" Placeholder="session id" />
            <Entry x:Name="TokenEntry" Placeholder="token" />
        </VerticalStackLayout>

        <!--
          Both containers exist for the whole session: the SDK hands its own render view out of a
          Publisher/Subscriber once one exists, and these are what it gets attached into — see
          OpenTokVideoView.cs.
        -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
            <local:OpenTokVideoView x:Name="LocalView" Grid.Column="0" />
            <local:OpenTokVideoView x:Name="RemoteView" Grid.Column="1" />
        </Grid>

        <HorizontalStackLayout Grid.Row="2" Spacing="8" HorizontalOptions="Center">
            <Button x:Name="ConnectButton" Text="Connect" Clicked="OnConnectClicked" />
            <Button x:Name="DisconnectButton" Text="Disconnect" Clicked="OnDisconnectClicked" IsEnabled="False" />
            <Button x:Name="PublishButton" Text="Publish" Clicked="OnPublishClicked" IsEnabled="False" />
        </HorizontalStackLayout>

        <ScrollView Grid.Row="3" x:Name="StatusScroll" HeightRequest="120">
            <Label x:Name="StatusLabel" FontSize="12" />
        </ScrollView>

    </Grid>

</ContentPage>
