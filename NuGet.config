<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Locally packed OpenTok.Net.*.Android packages. The package tests and the sample reference the
      packed .nupkg rather than the projects, so both run against exactly what gets published.
    -->
    <add key="local-artifacts" value="artifacts" />
  </packageSources>
</configuration>
